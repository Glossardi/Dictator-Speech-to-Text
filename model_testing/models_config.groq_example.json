  "test_config": {
    "runs_per_case": 3,
    "timeout_seconds": 30,
    "temperature": 0.3,
    "max_tokens": 2000,
    "parallel_requests": false,
    "_notes": {
      "runs_per_case": "How many times each test case is run per model (3 = good for consistency testing)",
      "timeout_seconds": "API timeout - increase for slower models",
      "temperature": "0.3 = somewhat creative but still focused (0 = deterministic, 1 = very creative)",
      "max_tokens": "Maximum response length",
      "parallel_requests": "false = sequential (safer for rate limits)"
    }
  },
  
  "evaluation_criteria": {
    "filler_words_removed": {
      "weight": 0.2,
      "keywords": ["äh", "ähm", "also", "ja", "naja"],
      "_notes": "Checks if common German filler words are removed"
    },
    "punctuation_correct": {
      "weight": 0.2,
      "check": "sentence_structure",
      "_notes": "Proper capitalization and punctuation"
    },
    "format_recognition": {
      "weight": 0.25,
      "types": ["email", "list", "paragraphs"],
      "_notes": "Recognizes different text formats and structures"
    },
    "self_corrections_resolved": {
      "weight": 0.15,
      "check": "repetitions_removed",
      "_notes": "Handles 'äh I mean' type self-corrections"
    },
    "language_maintained": {
      "weight": 0.1,
      "check": "no_translation",
      "_notes": "Doesn't translate or change language"
    },
    "no_added_content": {
      "weight": 0.1,
      "check": "length_similar",
      "_notes": "Doesn't add information or summarize"
    }
  }
}
