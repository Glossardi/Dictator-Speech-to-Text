# API Configuration
# Copy this file to .env and fill in your values

# Your LLM Provider API Key
LLM_API_KEY=your-api-key-here

# API Provider Base URL (without /chat/completions)
# Examples:
#   CROC API: https://api.croc.com/v1
#   OpenAI: https://api.openai.com/v1
#   DeepInfra: https://api.deepinfra.com/v1/openai
LLM_API_BASE_URL=https://api.croc.com/v1

# API Provider Name (for logging/display)
LLM_PROVIDER_NAME=CROC

# Optional: Specific models to test (comma-separated)
# Leave empty to auto-discover all available models from /models endpoint
# Example: LLM_MODELS=llama-3.1-8b-instant-128k,gpt-4o-mini-2024-07-18
LLM_MODELS=

# Test Configuration
TEST_RUNS_PER_CASE=3
TEST_TEMPERATURE=0.3
TEST_MAX_TOKENS=2000
TEST_TIMEOUT_SECONDS=30
